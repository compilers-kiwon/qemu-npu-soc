#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kiwon Kwon
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Boot kn1-evb without firmware: the kernel and the DTB are loaded by
# QEMU and the root file system is the ext4 image on a virtio disk.
# Generated into the images directory by post-image.sh.

IMAGES_DIR="${0%/*}"
cd "${IMAGES_DIR}" || exit 1

export PATH="@HOST_DIR@/bin:${PATH}"

exec qemu-system-aarch64 -M kn1-evb -nographic \
    -kernel Image -dtb kn1-evb.dtb \
    -append "rootwait root=/dev/vda console=ttyAMA0" \
    -drive file=rootfs.ext4,if=none,format=raw,id=hd0 \
    -device virtio-blk-device,drive=hd0 \
    "$@"
