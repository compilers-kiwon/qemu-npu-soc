#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kiwon Kwon
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Boot kn1-evb through the firmware chain. BL1 and the FIP (BL2, BL31,
# U-Boot) come from the boot flash image. U-Boot carries its own device
# tree and boots Linux through extlinux.conf on the GPT disk image, which
# QEMU exposes as a virtio disk. UART0 (U-Boot and Linux console) and
# UART1 (TF-A) share the terminal: Ctrl-a c switches the keyboard between
# them, Ctrl-a x quits QEMU.
# Generated into the images directory by post-image.sh.

IMAGES_DIR="${0%/*}"
cd "${IMAGES_DIR}" || exit 1

export PATH="@HOST_DIR@/bin:${PATH}"

exec qemu-system-aarch64 -M kn1-evb -display none \
    -chardev stdio,id=con,mux=on,signal=off \
    -serial chardev:con -serial chardev:con \
    -bios flash.bin \
    -drive file=disk.img,if=none,format=raw,id=hd0 \
    -device virtio-blk-device,drive=hd0 \
    "$@"
