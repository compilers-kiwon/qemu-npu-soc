config BR2_PACKAGE_KNPU_MODELS
	bool "knpu-models"
	help
	  The test model of the kn1-npu compiled to model.knpu, with
	  its inputs and expected outputs (/usr/share/knpu/conv/),
	  from models/conv/vectors/ of this repository. V6 runs them
	  with knpu-infer.
