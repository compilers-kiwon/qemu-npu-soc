From 035f21621ebef299f179949b0213f26babf210e6 Mon Sep 17 00:00:00 2001
From: Kiwon Kwon <compilers@naver.com>
Date: Fri, 6 Nov 2026 00:43:24 +0900
Subject: [PATCH] hw/arm: register the kiwon-kn1 SoC and the kn1-evb board

Add the Kconfig entries, the meson sources and the default.mak opt-out
line for the kiwon-kn1 SoC device and the kn1-evb machine. The sources
themselves (hw/arm/kiwon-kn1.c, hw/arm/kn1-evb.c and
include/hw/arm/kiwon-kn1.h) are copied into the tree by the build.

Signed-off-by: Kiwon Kwon <compilers@naver.com>
---
 configs/devices/aarch64-softmmu/default.mak |  1 +
 hw/arm/Kconfig                              | 20 ++++++++++++++++++++
 hw/arm/meson.build                          |  2 ++
 3 files changed, 23 insertions(+)

diff --git a/configs/devices/aarch64-softmmu/default.mak b/configs/devices/aarch64-softmmu/default.mak
index ad8028cfd..b03811e1b 100644
--- a/configs/devices/aarch64-softmmu/default.mak
+++ b/configs/devices/aarch64-softmmu/default.mak
@@ -9,4 +9,5 @@ include ../arm-softmmu/default.mak
 # CONFIG_XLNX_VERSAL=n
 # CONFIG_SBSA_REF=n
 # CONFIG_NPCM8XX=n
+# CONFIG_KN1_EVB=n
 CONFIG_VMAPPLE=n
diff --git a/hw/arm/Kconfig b/hw/arm/Kconfig
index 6f5b2add6..8b1cb8d58 100644
--- a/hw/arm/Kconfig
+++ b/hw/arm/Kconfig
@@ -624,6 +624,26 @@ config FSL_IMX8MP_EVK
     depends on TCG
     select FSL_IMX8MP
 
+config KIWON_KN1
+    bool
+    select ARM_GIC
+    select PL011 # UART
+    select PL031 # RTC
+    select PL061 # GPIO
+    select WDT_SBSA
+    select UNIMP
+
+config KN1_EVB
+    bool
+    default y
+    depends on AARCH64
+    depends on TCG
+    select DEVICE_TREE
+    select GPIO_PWR
+    select KIWON_KN1
+    select PFLASH_CFI01
+    select VIRTIO_MMIO
+
 config FSL_IMX8MM
     bool
     imply PCI_DEVICES
diff --git a/hw/arm/meson.build b/hw/arm/meson.build
index 4233a800b..c672fc3d1 100644
--- a/hw/arm/meson.build
+++ b/hw/arm/meson.build
@@ -86,6 +86,8 @@ arm_common_ss.add(when: 'CONFIG_FSL_IMX8MP', if_true: files('fsl-imx8mp.c'))
 arm_common_ss.add(when: 'CONFIG_FSL_IMX8MP_EVK', if_true: files('imx8mp-evk.c'))
 arm_common_ss.add(when: 'CONFIG_FSL_IMX8MM', if_true: files('fsl-imx8mm.c'))
 arm_common_ss.add(when: 'CONFIG_FSL_IMX8MM_EVK', if_true: files('imx8mm-evk.c'))
+arm_common_ss.add(when: 'CONFIG_KIWON_KN1', if_true: files('kiwon-kn1.c'))
+arm_common_ss.add(when: 'CONFIG_KN1_EVB', if_true: files('kn1-evb.c'))
 arm_common_ss.add(when: 'CONFIG_ARM_SMMUV3', if_true: files('smmuv3.c'))
 arm_common_ss.add(when: 'CONFIG_ARM_SMMUV3_ACCEL', if_true: files('smmuv3-accel.c'))
 stub_ss.add(files('smmuv3-accel-stubs.c'))
