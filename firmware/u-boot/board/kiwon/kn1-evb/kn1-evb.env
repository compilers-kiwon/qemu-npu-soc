/*
 * Default environment for kn1-evb. Load addresses are in the first DRAM
 * bank, below U-Boot's own load address (0x60000000, the TF-A BL33 entry).
 */

scriptaddr=0x40200000
pxefile_addr_r=0x40300000
kernel_addr_r=0x40400000
fdt_addr_r=0x4c000000
ramdisk_addr_r=0x4c100000
boot_targets=virtio
