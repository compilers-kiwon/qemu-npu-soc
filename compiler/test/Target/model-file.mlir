// RUN: knpu-translate --knpu-to-model %s | od -A d -t x4 -v -w4 | FileCheck %s

// The example of docs/npu-spec.md 12 as command operations. The command
// stream knpu-translate writes must be the 42 words of the specification's
// table; unchanged SET values are not repeated and each wait comes right
// before the OP word it guards. The layout follows docs/model-format.md:
// header, a table of four sections, CMDS at 96 (168 bytes), REGIONS at 272,
// CONST at 304, TENSORS at 416, end of file at 512.

module attributes {knpu.sram_size = 65536 : i64} {
  knpu.region 0 "const" size 112 content dense<"0x000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F404142434445464748494A4B4C4D4E4F505152535455565758595A5B5C5D5E5F606162636465666768696A6B6C6D6E6F"> : tensor<112xi8>
  knpu.region 1 "arena" size 320
  knpu.io "input" region 1 [0] shape [1, 8, 8, 1] scale 1.0 zero_point -128
  knpu.io "output" region 1 [64] shape [1, 8, 8, 4] scale 0.5 zero_point 0
  func.func @knpu_model() {
    knpu.dma "load" region 0 [0] sram [256] length 112 count 1 stride 0
    knpu.dma "load" region 1 [0] sram [0] length 64 count 1 stride 0
    knpu.dma_wait 0
    knpu.conv {ifm = 0 : i64, ifm_shape = array<i64: 8, 8, 1>, ifm_zp = -128 : i64, ofm = 512 : i64, ofm_shape = array<i64: 8, 8, 4>, ofm_zp = 0 : i64, weight = 256 : i64, bias = 320 : i64, rq_table = 336 : i64, kernel = array<i64: 3, 3>, stride = array<i64: 1, 1>, pad = array<i64: 1, 1, 1, 1>, clamp = array<i64: -128, 127>, round = "double"}
    knpu.kernel_wait 0
    knpu.dma "store" region 1 [64] sram [512] length 256 count 1 stride 0
    knpu.stop
    return
  }
}

