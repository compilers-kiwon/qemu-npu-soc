# Pinned downloads of the compiler, each checked by SHA-256
# (docs/design.md 12.2, 14).
#
# - lcc: the aarch64 mlir driver of the lcc_llvm release (runs on x86_64).
#   lcc is not part of this repository because of its license
#   (docs/design.md 12.4). KNPU_LCC_DIR may point to an unpacked copy.
# - The TFLite Python schema that tflite2c reads .tflite files with.
#
# The generator also needs the PyPI package flatbuffers 25.9.23.

set(KNPU_DEPS_DIR ${KNPU_BINARY_DIR}/deps)

function(knpu_download url sha256 path)
  if(NOT EXISTS ${path})
    message(STATUS "Downloading ${url}")
  endif()
  file(DOWNLOAD ${url} ${path} EXPECTED_HASH SHA256=${sha256}
       STATUS st TLS_VERIFY ON)
  list(GET st 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Could not download ${url}: ${st}")
  endif()
endfunction()

# lcc v4.2-llvm.3 (tag -> 361944729b594bb43d907b2083dedff23c3b1da6)
set(KNPU_LCC_TAG v4.2-llvm.3)
set(KNPU_LCC_NAME lcc-${KNPU_LCC_TAG}-mlir-aarch64-linux)
set(KNPU_LCC_SHA256
    61fb64b5fe472f16e008bda6e67aa49d36cb4538b6e6db9d6b8d766c97321009)
set(KNPU_LCC_DIR "" CACHE PATH
    "Unpacked ${KNPU_LCC_NAME} (empty: download it)")
if(NOT KNPU_LCC_DIR)
  set(tarball ${KNPU_DEPS_DIR}/${KNPU_LCC_NAME}.tar.gz)
  knpu_download(
    https://github.com/compilers-kiwon/lcc_llvm/releases/download/${KNPU_LCC_TAG}/${KNPU_LCC_NAME}.tar.gz
    ${KNPU_LCC_SHA256} ${tarball})
  set(lcc_dir ${KNPU_DEPS_DIR}/${KNPU_LCC_NAME})
  if(NOT EXISTS ${lcc_dir}/lcc)
    file(ARCHIVE_EXTRACT INPUT ${tarball} DESTINATION ${KNPU_DEPS_DIR})
  endif()
  set(KNPU_LCC_DIR ${lcc_dir} CACHE PATH
      "Unpacked ${KNPU_LCC_NAME} (empty: download it)" FORCE)
endif()
if(NOT EXISTS ${KNPU_LCC_DIR}/lcc)
  message(FATAL_ERROR "No lcc driver in KNPU_LCC_DIR=${KNPU_LCC_DIR}")
endif()

# TFLite Python schema, generated by flatc (Apache-2.0)
set(KNPU_TFLM_COMMIT fd2a85dfb3bedac81920e8667565b1044c6b6a43)
set(KNPU_TFLITE_SCHEMA ${KNPU_DEPS_DIR}/schema_py_generated.py)
knpu_download(
  https://raw.githubusercontent.com/tensorflow/tflite-micro/${KNPU_TFLM_COMMIT}/tensorflow/lite/micro/python/schema_py_generated.py
  55c211fce48f1339fcf401f89186b385ba6f565b52ba402cceb453ce8fcf9135
  ${KNPU_TFLITE_SCHEMA})

execute_process(
  COMMAND ${Python3_EXECUTABLE} -c
          "import flatbuffers; print(flatbuffers.__version__)"
  OUTPUT_VARIABLE fb_version OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE fb_result ERROR_QUIET)
if(NOT fb_result EQUAL 0)
  message(FATAL_ERROR "tflite2c needs the Python package flatbuffers "
                      "(pip install flatbuffers==25.9.23)")
elseif(NOT fb_version STREQUAL "25.9.23")
  message(WARNING "Python flatbuffers ${fb_version}; tested with 25.9.23")
endif()
