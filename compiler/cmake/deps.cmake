# Pinned downloads of the compiler, each checked by SHA-256
# (docs/design.md 12.2, 14).
#
# - lcc: the aarch64 mlir driver of the lcc_llvm release (runs on x86_64).
#   lcc is not part of this repository because of its license
#   (docs/design.md 12.4). KNPU_LCC_DIR may point to an unpacked copy.
# - The lcc_llvm source of the same tag, for building lcc-opt.
# - The TFLite Python schema that tflite2c reads .tflite files with.
#
# The generator also needs the PyPI package flatbuffers 25.9.23. The CPU
# code of a model also needs mlir-translate, clang and ld.lld of LLVM 23
# (docs/design.md 9.4).

set(KNPU_DEPS_DIR ${KNPU_BINARY_DIR}/deps)

function(knpu_download url sha256 path)
  if(NOT EXISTS ${path})
    message(STATUS "Downloading ${url}")
  endif()
  file(DOWNLOAD ${url} ${path} EXPECTED_HASH SHA256=${sha256}
       STATUS st TLS_VERIFY ON)
  list(GET st 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Could not download ${url}: ${st}")
  endif()
endfunction()

# lcc v4.2-llvm.3 (tag -> 361944729b594bb43d907b2083dedff23c3b1da6)
set(KNPU_LCC_TAG v4.2-llvm.3)
set(KNPU_LCC_NAME lcc-${KNPU_LCC_TAG}-mlir-aarch64-linux)
set(KNPU_LCC_SHA256
    61fb64b5fe472f16e008bda6e67aa49d36cb4538b6e6db9d6b8d766c97321009)
set(KNPU_LCC_DIR "" CACHE PATH
    "Unpacked ${KNPU_LCC_NAME} (empty: download it)")
if(NOT KNPU_LCC_DIR)
  set(tarball ${KNPU_DEPS_DIR}/${KNPU_LCC_NAME}.tar.gz)
  knpu_download(
    https://github.com/compilers-kiwon/lcc_llvm/releases/download/${KNPU_LCC_TAG}/${KNPU_LCC_NAME}.tar.gz
    ${KNPU_LCC_SHA256} ${tarball})
  set(lcc_dir ${KNPU_DEPS_DIR}/${KNPU_LCC_NAME})
  if(NOT EXISTS ${lcc_dir}/lcc)
    file(ARCHIVE_EXTRACT INPUT ${tarball} DESTINATION ${KNPU_DEPS_DIR})
  endif()
  set(KNPU_LCC_DIR ${lcc_dir} CACHE PATH
      "Unpacked ${KNPU_LCC_NAME} (empty: download it)" FORCE)
endif()
if(NOT EXISTS ${KNPU_LCC_DIR}/lcc)
  message(FATAL_ERROR "No lcc driver in KNPU_LCC_DIR=${KNPU_LCC_DIR}")
endif()

# lcc-opt from the lcc_llvm source of the same tag. It links libMLIR.so like
# the packaged mlir-opt, so it is a project of its own next to this one,
# whose tools link MLIR statically (docs/design.md 9.4). The source archive
# also holds lcc, which is why it stays in the build directory
# (docs/design.md 12.4). GitHub names its top directory without the "v".
set(KNPU_LCC_LLVM_SHA256
    d1a856fa7ffd5948d26bbf70eec86ac0611c244c03c6ee5a6dc382dfae7516bf)
set(lcc_llvm_tarball ${KNPU_DEPS_DIR}/lcc_llvm-${KNPU_LCC_TAG}.tar.gz)
knpu_download(
  https://github.com/compilers-kiwon/lcc_llvm/archive/refs/tags/${KNPU_LCC_TAG}.tar.gz
  ${KNPU_LCC_LLVM_SHA256} ${lcc_llvm_tarball})
string(REGEX REPLACE "^v" "" lcc_llvm_version ${KNPU_LCC_TAG})
set(lcc_llvm_dir ${KNPU_DEPS_DIR}/lcc_llvm-${lcc_llvm_version})
if(NOT EXISTS ${lcc_llvm_dir}/lcc-opt/CMakeLists.txt)
  file(ARCHIVE_EXTRACT INPUT ${lcc_llvm_tarball} DESTINATION ${KNPU_DEPS_DIR})
endif()
# Its build runs next to this one's and does not share the job limit; a
# translation unit of lcc-opt takes up to about 1 GB, so it builds 4 at a
# time.
include(ExternalProject)
ExternalProject_Add(lcc-opt
  SOURCE_DIR ${lcc_llvm_dir}/lcc-opt
  BINARY_DIR ${KNPU_BINARY_DIR}/lcc-opt
  CMAKE_ARGS -DMLIR_DIR=${MLIR_DIR} -DCMAKE_BUILD_TYPE=Release
             -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
             -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
  BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --parallel 4
  INSTALL_COMMAND ""
  BUILD_BYPRODUCTS ${KNPU_BINARY_DIR}/lcc-opt/bin/lcc-opt)
set(KNPU_LCC_OPT ${KNPU_BINARY_DIR}/lcc-opt/bin/lcc-opt)

# The other tools of the CPU code, from the LLVM 23 of MLIR_DIR
find_program(KNPU_MLIR_TRANSLATE mlir-translate
             PATHS ${LLVM_TOOLS_BINARY_DIR} NO_DEFAULT_PATH)
find_program(KNPU_CLANG clang PATHS ${LLVM_TOOLS_BINARY_DIR} NO_DEFAULT_PATH)
find_program(KNPU_LD_LLD ld.lld PATHS ${LLVM_TOOLS_BINARY_DIR} NO_DEFAULT_PATH)
if(NOT KNPU_MLIR_TRANSLATE OR NOT KNPU_CLANG OR NOT KNPU_LD_LLD)
  message(FATAL_ERROR "The CPU code of a model needs mlir-translate, clang "
                      "and ld.lld in ${LLVM_TOOLS_BINARY_DIR} (apt packages "
                      "mlir-23-tools, clang-23 and lld-23)")
endif()

# TFLite Python schema, generated by flatc (Apache-2.0)
set(KNPU_TFLM_COMMIT fd2a85dfb3bedac81920e8667565b1044c6b6a43)
set(KNPU_TFLITE_SCHEMA ${KNPU_DEPS_DIR}/schema_py_generated.py)
knpu_download(
  https://raw.githubusercontent.com/tensorflow/tflite-micro/${KNPU_TFLM_COMMIT}/tensorflow/lite/micro/python/schema_py_generated.py
  55c211fce48f1339fcf401f89186b385ba6f565b52ba402cceb453ce8fcf9135
  ${KNPU_TFLITE_SCHEMA})

execute_process(
  COMMAND ${Python3_EXECUTABLE} -c
          "import flatbuffers; print(flatbuffers.__version__)"
  OUTPUT_VARIABLE fb_version OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE fb_result ERROR_QUIET)
if(NOT fb_result EQUAL 0)
  message(FATAL_ERROR "tflite2c needs the Python package flatbuffers "
                      "(pip install flatbuffers==25.9.23)")
elseif(NOT fb_version STREQUAL "25.9.23")
  message(WARNING "Python flatbuffers ${fb_version}; tested with 25.9.23")
endif()
